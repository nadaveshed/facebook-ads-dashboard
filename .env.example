# Copy this file to .env and fill in your values. Do not commit .env.

# Database (used by backend, scraper, and docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ads_db

# Full DB URL for app services (when not using docker-compose)
# For Docker: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
# For local:  postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ads_db

# Backend
PORT=3001
ASSETS_DIR=./assets
FRONTEND_URL=http://localhost:3000

# Scraper
TARGET_URL=https://www.facebook.com/ads/library/?active_status=all&ad_type=all&country=US&is_targeted_country=false&media_type=all&search_type=page&view_all_page_id=15087023444
MAX_ADS=50
SCROLL_DELAY_MS=2000
HEADLESS=true
# ASSETS_DIR is shared with backend (see above)
