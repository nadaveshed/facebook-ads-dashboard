{
    "name": "facebook-ads-backend",
    "version": "1.0.0",
    "description": "Backend API for Facebook Ads Dashboard",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn src/server.ts",
        "test": "jest",
        "lint": "eslint src/**/*.ts",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "drizzle-orm": "^0.36.0",
        "express": "^4.18.2",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "drizzle-kit": "^0.28.0",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.0",
        "@types/pg": "^8.10.9",
        "typescript": "^5.3.2",
        "ts-node-dev": "^2.0.0"
    }
